# .env.example — 빌드 타임 플래그 (src/app/flags.js)
#
# 평소엔 이 파일을 복사할 필요가 없다.
#   npm run dev    → 두 플래그 모두 자동 ON  (개발 편의 기능 켜짐)
#   npm run build  → 두 플래그 모두 자동 OFF (출시 상태)
#
# 아래는 "프로덕션 빌드인데 잠깐 켜야 할 때"만 쓴다. 예: 검수용 배포에서 전 무대를 바로 보고 싶을 때.
# 사용법: 이 파일을 .env.local 로 복사해 값을 넣거나, Vercel 대시보드의
#         Environment Variables 에 등록한다(.env 계열은 .gitignore 로 추적 제외).
#
# ⚠️ 빌드 시점에 정적 치환되므로 값을 바꾸면 반드시 재빌드/재배포해야 반영된다.

# 무대(챕터) 순차 잠금을 해제한다.
# 기본(빈 값/미설정) = 잠금. ch1 을 모두 클리어해야 ch2 가 열린다.
VITE_UNLOCK_ALL=

# 게임 내 '⏭ 건너뛰기(테스트)' 버튼과 window.__dev 디버그 훅을 켠다.
# ⚠️ 이걸 켜서 배포하면 학생이 모든 미니게임을 건너뛸 수 있다. 검수용으로만 쓸 것.
VITE_DEV_TOOLS=
